{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges 100.0.0.0/8
	}
}

:{$PORT:8080} {
	root * {$SITE_ROOT:/srv}

	# one canonical host
	@apex host polyglotmusic.co
	redir @apex https://www.polyglotmusic.co{uri} permanent
	encode zstd gzip

	# clean URLs: /product is the page, /product.html and /index.html redirect to it (one URL per page)
	@index path /index.html
	redir @index / permanent
	@html path_regexp html ^(/.+)\.html$
	redir @html {re.html.1} permanent
	@notfound path /404 /404.html
	error @notfound 404

	# build files are not part of the site
	@private path /Dockerfile /Caddyfile /CNAME /.nojekyll /README.md /.git*
	respond @private 404

	# fingerprinted assets cache for a year; pages always revalidate
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	@pages path / *.html
	header @pages Cache-Control "public, max-age=0, must-revalidate"
	@pages2 not path /assets/* *.png *.ico *.svg *.webmanifest *.txt *.xml
	header @pages2 Cache-Control "public, max-age=0, must-revalidate"
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options SAMEORIGIN
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# /product serves product.html; index is /
	try_files {path} {path}.html
	file_server

	handle_errors {
		@404 expression {err.status_code} == 404
		handle @404 {
			rewrite * /404.html
			file_server
		}
	}
}
